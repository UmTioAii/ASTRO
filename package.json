{
  "name": "@umtioai/astro-harness",
  "version": "0.1.0-alpha.1",
  "description": "Harness single-agent em Bun/TypeScript com ledger de uso e auditoria append-only.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "astro": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmTioAii/ASTRO.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --external ink --external react --outfile dist/cli.js && bun build src/launcher.ts --target=node --outfile dist/launcher.js",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "eval": "bun src/cli.ts eval",
    "bench:providers": "bun src/cli.ts bench"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "latest"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "optionalDependencies": {
    "@oven/bun-darwin-aarch64": "1.4.2",
    "@oven/bun-darwin-x64": "1.4.2",
    "@oven/bun-freebsd-aarch64": "1.4.2",
    "@oven/bun-freebsd-x64": "1.4.2",
    "@oven/bun-linux-aarch64": "1.4.2",
    "@oven/bun-linux-aarch64-android": "1.4.2",
    "@oven/bun-linux-aarch64-musl": "1.4.2",
    "@oven/bun-linux-x64": "1.4.2",
    "@oven/bun-linux-x64-android": "1.4.2",
    "@oven/bun-linux-x64-musl": "1.4.2",
    "@oven/bun-windows-aarch64": "1.4.2",
    "@oven/bun-windows-x64": "1.4.2"
  }
}
