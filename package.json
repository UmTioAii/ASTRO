{
  "name": "@umtioai/astro-harness",
  "version": "0.1.0-alpha.0",
  "description": "Harness single-agent em Bun/TypeScript com ledger de uso e auditoria append-only.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "astro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmTioAii/ASTRO.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --external ink --external react --outfile dist/cli.js",
    "prepublishOnly": "bun run typecheck && bun run build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "eval": "bun src/cli.ts eval",
    "bench:providers": "bun src/cli.ts bench"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "latest"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1"
  }
}
