{
  "name": "@umtioaii/astro-harness",
  "version": "0.1.0-alpha.3",
  "description": "Multi-agent coding harness for AI agents. Features deterministic model routing, append-only audit ledgers, cost governance, and durable handoffs. Built with Bun & TypeScript.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "astro": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmTioAii/ASTRO-Harness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --external ink --external react --outfile dist/cli.js && bun build src/launcher.ts --target=node --outfile dist/launcher.js",
    "cli": "bun src/cli.ts",
    "tui": "bun src/cli.ts tui",
    "dev:launcher": "bun run build && node dist/launcher.js",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "eval": "bun src/cli.ts eval",
    "bench:providers": "bun src/cli.ts bench"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "latest"
  },
  "dependencies": {
    "bun": "1.4.2",
    "ink": "8.0.0",
    "react": "19.3.1"
  }
}
